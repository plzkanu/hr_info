# 세션 서명용 비밀키. 미설정·예시값이면 서버가 기동하지 않습니다.
# 아래 예시 문자열을 그대로 쓰지 말고 16자 이상 임의값으로 바꾸세요.
AUTH_SECRET=your-random-secret-key-here

# Supabase hr_info (Project Settings → API) — 로그인 계정·앱 설정
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase manmanage — 공사경력 테이블
MANMANAGE_SUPABASE_URL=https://astqnlyukxmbixoxbfbx.supabase.co
MANMANAGE_SUPABASE_SERVICE_ROLE_KEY=your-manmanage-service-role-key

# 개발 PC에서 회사 VPN이 인증서 검사를 막을 때만 아래 주석을 해제하세요.
# 운영(Replit) Secrets에는 넣지 마세요. NODE_ENV=production이면 무시됩니다.
# SUPABASE_SSL_VERIFY=0
