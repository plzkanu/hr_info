run = "node node_modules/next/dist/bin/next start -H 0.0.0.0 -p 3000"
modules = ["nodejs-24"]

[deployment]
deploymentTarget = "gce"
build = ["node", "scripts/build-prod.mjs"]
run = ["node", "node_modules/next/dist/bin/next", "start", "-H", "0.0.0.0", "-p", "3000"]

[env]
HOST = "0.0.0.0"
PORT = "3000"

[[ports]]
localPort = 3000
externalPort = 80
